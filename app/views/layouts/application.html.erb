<!DOCTYPE html>
<html lang="en">
<head>
  <%= render "shared/head", icon_prefix: "favicon" %>
</head>
<body class="<%= controller_name %> <%= action_name %>">
  <div id="content">
    <div id="masthead">
      <div id="name" class="pull-left">
        <%= link_to "Daniel Hillman", root_path %>
      </div>
      <div id="icon" class="pull-right">
        <i class="fa fa-gamepad"></i>
      </div>
    </div>
    <div id="navigation">
      <ul>
        <li><%= link_to "About", about_path, class: ("active" if action?("about")) %></li>
        <li><%= link_to "Work", work_path, class: ("active" if action?("work")) %></li>
        <li><%= link_to "Blog", posts_path %></li>
        <li><%= link_to "Contact", contact_path, class: ("active" if action?("contact")) %></li>
      </ul>
    </div>

    <div id="main">
      <%= yield %>
    </div>
  </div>
</body>
</html>
