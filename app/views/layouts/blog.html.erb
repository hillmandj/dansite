<!DOCTYPE html>
<html lang="en">
<head>
  <%= render "shared/head", icon_prefix: "danicon" %>
  <%= javascript_include_tag "blog", defer: true %>
</head>
<body class="<%= controller_name %> <%= action_name %>">
  <div id="blog-content">
    <div id="sidebar" class="pull-left">
      <div id="sidebar-brand">
        <%= link_to root_path do %><span id="first-name">Daniel</span><span id="last-name"> Hillman</span><% end %>
      </div>
      <ul id="sidebar-nav">
        <li id="foreign-links">
          <a href="https://github.com/hillmandj" target="_blank" rel="noopener"><i class="fa fa-github"></i></a>
          <a href="https://facebook.com/hillmandj" target="_blank" rel="noopener"><i class="fa fa-facebook"></i></a>
          <a href="https://linkedin.com/in/hillmandj" target="_blank" rel="noopener"><i class="fa fa-linkedin"></i></a>
        </li>
        <li><%= link_to "Posts", posts_path %></li>
        <li><%= link_to "About", about_path %></li>
        <li>
          <% if user_signed_in? %>
            <%= link_to drafts_path, id: "drafts-link", class: ("bold" if Draft.exists? && controller_name != "drafts") do %>
              Drafts (<span id="drafts-count"><%= Draft.count %></span>)
            <% end %>
            <br>
            <%= link_to "Settings", edit_user_registration_path %>
            <br>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-link logout-button", form_class: "logout-form" %>
          <% else %>
            <%= link_to "Login", new_user_session_path %>
          <% end %>
        </li>
      </ul>
    </div>
    <div id="blog-main" class="pull-left">
      <% flash.each do |type, message| %>
        <div class="alert <%= type.to_s.in?(%w[alert error]) ? "alert-danger" : "alert-info" %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </div>
  </div>
</body>
</html>
