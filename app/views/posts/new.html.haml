%h2#post-header New Post
= render partial: 'preview'
= form_with model: @post do |f|
  .form-group
    = f.label 'Title'
    = f.text_field 'title', class: 'form-control'
  .form-group
    = f.label 'Content'
    = f.text_area 'content', class: 'form-control'
  .form-group
    = f.submit 'Submit', class: 'btn btn-primary'
    = link_to 'Preview', '#', id: 'post-preview', class: 'btn btn-success'
    = link_to 'Save Draft', '#', id: 'save-draft', class: 'btn btn-danger'
