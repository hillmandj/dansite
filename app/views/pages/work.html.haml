#work-container
  %h3#banner
    \%r(<span id="sites">sites</span><span id="bar">|</span><span id="projects">projects</span>)
  #intro Below is a list of sites I've contributed to and some personal projects.
  %ul#work-list
    - @projects.each do |project|
      %li
        %h3.name= link_to project.name, project.site_url, target: "_blank", rel: "noopener"
        - if project.has_image?
          .image-wrapper.text-center
            = link_to project.site_url, target: "_blank", rel: "noopener" do
              = image_tag project.image_url, class: "img-responsive", alt: project.name
        .description.text-center
          = simple_format(project.description)
