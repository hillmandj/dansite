<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= content_for(:title) || "Daniel Hillman" %></title>
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<%= favicon_link_tag "icons/#{icon_prefix}-32x32.png", rel: "icon", sizes: "32x32", type: "image/png" %>
