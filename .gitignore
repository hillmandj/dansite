# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

# Environment files
/.env*

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

# SQLite databases (production data lives in a Docker volume on the droplet)
/storage/*
!/storage/.keep
/db/*.sqlite3*

# Precompiled assets
/public/assets

# Encryption key for config/credentials.yml.enc. Keep it secret, keep it safe.
/config/master.key

*.swp
.DS_Store

# Ignore key files for decrypting credentials and more.
/config/*.key

