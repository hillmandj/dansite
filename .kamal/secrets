# Secrets for Kamal, read from the environment or local files. This file is safe to
# commit because it holds no secret values, only where to read them from.
#
# KAMAL_REGISTRY_PASSWORD: a GitHub token that can write packages to ghcr.io.
#   Locally:  export KAMAL_REGISTRY_PASSWORD=<personal access token with write:packages>
#   In CI:    provided by the workflow from GITHUB_TOKEN.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# RAILS_MASTER_KEY: decrypts config/credentials.yml.enc.
#   Locally:  read from config/master.key (gitignored).
#   In CI:    set as the RAILS_MASTER_KEY repository secret.
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key)}
