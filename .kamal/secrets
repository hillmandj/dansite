# Secrets for Kamal, read from the environment or local files. This file is safe to
# commit because it holds no secret values, only where to read them from.
#
# KAMAL_REGISTRY_PASSWORD: a GitHub token that can write packages to ghcr.io.
#   Locally:  export KAMAL_REGISTRY_PASSWORD=<personal access token with write:packages>
#   In CI:    provided by the workflow from GITHUB_TOKEN.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# RAILS_MASTER_KEY: decrypts config/credentials.yml.enc, read from config/master.key
# (gitignored). In CI the deploy workflow writes that file from the RAILS_MASTER_KEY
# repository secret. Note: this file is parsed as dotenv, not by a shell, so shell
# syntax like ${VAR:-default} is NOT supported.
RAILS_MASTER_KEY=$(cat config/master.key)
